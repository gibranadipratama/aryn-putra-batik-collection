generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ----------------------------------------------------------------------------
// USER & AUTHENTICATION
// ----------------------------------------------------------------------------
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relasi
  orders        Order[]
  accounts      Account[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

enum Role {
  USER      // Pelanggan eceran biasa
  RESELLER  // Pelanggan dengan akses harga grosir
  ADMIN     // Pemilik toko/karyawan
}

// ----------------------------------------------------------------------------
// PRODUK & KATALOG
// ----------------------------------------------------------------------------
model Category {
  id          String    @id @default(cuid())
  name        String    @unique // cth: Batik Tulis, Batik Cap
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relasi
  products    Product[]
}

model Product {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  sku         String    @unique // Stock Keeping Unit
  stock       Int       @default(0)
  images      String[]  // Array URL gambar
  
  // Harga dipisah antara ecer dan grosir
  retailPrice Float     // Harga eceran
  grosirPrice Float     // Harga khusus reseller
  
  // Ketentuan Grosir
  minOrderGrosir Int    @default(1) // Minimal beli untuk harga grosir (jika bukan reseller)
  
  isAvailable Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relasi
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
}

// ----------------------------------------------------------------------------
// PESANAN & TRANSAKSI
// ----------------------------------------------------------------------------
model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  totalAmount Float
  status      OrderStatus @default(PENDING)
  isResellerOrder Boolean @default(false) // Penanda apakah ini transaksi grosir
  
  // Alamat Pengiriman
  shippingAddress String  @db.Text
  city            String
  postalCode      String
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relasi
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  orderItems  OrderItem[]
}

model OrderItem {
  id        String   @id @default(cuid())
  quantity  Int
  price     Float    // Harga pasti saat checkout (ecer/grosir) direkam di sini
  
  // Relasi
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}